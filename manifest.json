{
  "manifest_version": 3,
  "name": "Cookie Rejector",
  "short_name": "CookieRej",
  "version": "0.3.2",
  "author": "Paweł Arciszewski",
  "description": "Automatycznie odrzuca zgody cookie (zostawia tylko niezbędne i funkcjonalne). Przy ścianach 'zgoda albo płać' pyta o decyzję.",
  "permissions": ["storage", "tabs"],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Cookie Rejector",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/page-api.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/shared.js", "src/rules.js", "src/ui.js", "src/content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
